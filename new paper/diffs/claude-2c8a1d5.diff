+/// info record of a node, which is where all the network simplex state lives
+#define NI(n) ((Agnodeinfo_t *)AGDATA(n))
+
+/// the slice of `network_simplex_ctx_t::tree_nbrs` shadowing a tree edge list
+static Agnodeinfo_t **tree_nbr(network_simplex_ctx_t *ctx, elist l) {
+    return ctx->tree_nbrs + (l.list - ctx->tree_lists);
+}
