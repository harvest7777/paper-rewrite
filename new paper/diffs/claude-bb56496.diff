+	slot += i + 1;
 	for (i = 0; ND_out(n).list[i]; i++);
-	ND_tree_out(n).list = gv_calloc(i + 1, sizeof(edge_t *));
+	ND_tree_out(n).list = slot;
 	ND_tree_out(n).size = 0;
+	slot += i + 1;
     }
+    assert((size_t)(slot - ctx->tree_lists) == slots);
     return feasible;
