       }
-      free_list(ND_tree_in(n));
-      free_list(ND_tree_out(n));
+      ND_tree_in(n) = (elist){0};
+      ND_tree_out(n) = (elist){0};
       ND_mark(n) = false;
@@ -911,2 +915,3 @@ static bool init_graph(network_simplex_ctx_t *ctx, graph_t *g) {
     *ctx = (network_simplex_ctx_t){.G = g};
