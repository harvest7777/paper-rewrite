+/// gather the crossing-count keys of one end of a node's edge list
+///
+/// @param list NULL-terminated edge list to walk
+/// @param head Take the head end of each edge (otherwise the tail end)
+/// @param buf Caller-provided space for up to `XKEY_STATIC` entries
+/// @param n Set to the number of entries gathered
+/// @return `buf`, or a heap allocation the caller must free if it did not fit
+static xkey_t *xkeys(edge_t **list, bool head, xkey_t *buf, size_t *n) {
+  size_t len = 0;
+  for (edge_t **e = list; *e; e++) {
+    ++len;
+  }
+  xkey_t *const keys = len <= XKEY_STATIC ? buf : gv_calloc(len, sizeof(xkey_t));
+  for (size_t i = 0; i < len; ++i) {
+    edge_t *const e = list[i];
+    keys[i].pen = ED_xpenalty(e);
+    if (head) {
+      keys[i].order = ND_order(aghead(e));
+      keys[i].x = ED_head_port(e).p.x;
+    } else {
+      keys[i].order = ND_order(agtail(e));
+      keys[i].x = ED_tail_port(e).p.x;
     }
   }
-  return cross;
