+/** count crossings between two adjacent nodes' edge lists, both ways at once
+ *
+ * `c0` accumulates the crossings incurred with `v` left of `w` and `c1` those
+ * incurred with them swapped. Every pair of edges contributes to exactly one of
+ * the two (or to neither, when it is a tie), so both orderings can be counted
+ * in a single pass over the pairs instead of four separate nested loops with
+ * the edge attributes re-read from cold memory each time.
+ */
+static void cross_pair(edge_t **vlist, edge_t **wlist, bool head, int64_t *c0,
+                       int64_t *c1) {
+  xkey_t vbuf[XKEY_STATIC];
+  xkey_t wbuf[XKEY_STATIC];
+  size_t vn, wn;
+  xkey_t *const vk = xkeys(vlist, head, vbuf, &vn);
+  xkey_t *const wk = xkeys(wlist, head, wbuf, &wn);
+
+  int64_t a = 0;
+  int64_t b = 0;
+  for (size_t i = 0; i < vn; ++i) {
+    const int vo = vk[i].order;
+    const int vp = vk[i].pen;
+    const double vx = vk[i].x;
+    for (size_t j = 0; j < wn; ++j) {
+      const int t = vo - wk[j].order;
+      const int prod = vp * wk[j].pen;
+      if (t > 0 || (t == 0 && vx > wk[j].x)) {
+        a += prod;
+      } else if (t < 0 || (t == 0 && wk[j].x > vx)) {
+        b += prod;
+      }
     }
   }
-  return cross;
+  *c0 += a;
+  *c1 += b;
+
+  if (vk != vbuf) {
+    free(vk);
+  }
+  if (wk != wbuf) {
+    free(wk);
+  }
 }
