     if (r > 0) {
-      c0 += in_cross(v, w);
-      c1 += in_cross(w, v);
+      cross_pair(ND_in(v).list, ND_in(w).list, false, &c0, &c1);
     }
     if (GD_rank(g)[r + 1].n > 0) {
-      c0 += out_cross(v, w);
-      c1 += out_cross(w, v);
