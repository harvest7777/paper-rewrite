+#define NS(ctx, n) (&(ctx)->states[ND_priority(n)])
+
 /// the slice of `network_simplex_ctx_t::tree_nbrs` shadowing a tree edge list
@@ -91,2 +119,21 @@ static Agnodeinfo_t **tree_nbr(network_simplex_ctx_t *ctx, elist l) {
 
+/// as `tree_nbr`, but the shadow pointing into `network_simplex_ctx_t::states`
+static ns_state_t **tree_state(network_simplex_ctx_t *ctx, elist l) {
+    return ctx->tree_states + (l.list - ctx->tree_lists);
+}
+
+/// set up `network_simplex_ctx_t::states`, once the tree lists exist
+static void init_states(network_simplex_ctx_t *ctx) {
+    ctx->states = gv_calloc(ctx->N_nodes, sizeof(ns_state_t));
+    ctx->nis = gv_calloc(ctx->N_nodes, sizeof(Agnodeinfo_t *));
+    size_t i = 0;
+    for (node_t *n = GD_nlist(ctx->G); n != NULL; n = ND_next(n), ++i) {
+	assert(i <= INT_MAX);
+	ND_priority(n) = (int)i;
+	ctx->nis[i] = NI(n);
+	ctx->states[i].tree_out = ND_tree_out(n).list;
+	ctx->states[i].tree_in = ND_tree_in(n).list;
+    }
+}
