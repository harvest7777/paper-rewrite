+/** everything `dfs_range` knows about a node, held densely
+ *
+ * `dfs_range` is the hottest loop in `dot` and touches nothing else about a
+ * node, so keeping just this in a packed array (32 bytes per node) instead of
+ * reaching into the ~470 byte `Agnodeinfo_t` records keeps its whole working
+ * set resident in cache for graphs of tens of thousands of nodes.
+ */
+typedef struct {
+    edge_t *par;       ///< `ND_par(n)`
