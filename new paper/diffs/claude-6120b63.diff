-    int in_i;        ///< iteration counter through `v->tree_in.list`
+    ns_state_t *v; ///< state of the node this frame is visiting
+    edge_t *par;   ///< tree edge connecting `v` to its parent
+    int out_i;     ///< iteration counter through `v->tree_out`
